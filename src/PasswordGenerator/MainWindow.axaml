<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PasswordGenerator.MainWindow"
        Title="Password Generator"
        Width="500"
        Height="610"
        MinWidth="430"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#A1A1AA" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="28">
    <StackPanel Spacing="6">
      <TextBlock Text="PASSWORD GENERATOR"
                 FontSize="12"
                 FontWeight="Bold"
                 Foreground="#F97316" />
      <TextBlock Text="Create a strong password"
                 FontSize="24"
                 FontWeight="SemiBold" />
      <TextBlock Classes="muted"
                 Text="Choose what goes into your password. Generated on your device." />
    </StackPanel>

    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="12">
      <Border Background="#27272A" CornerRadius="10" Padding="16">
        <TextBlock x:Name="PasswordText"
                   Text=""
                   FontFamily="monospace"
                   FontSize="18"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
      </Border>

      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <TextBlock Text="Length" VerticalAlignment="Center" />
        <TextBlock x:Name="LengthValue"
                   Grid.Column="1"
                   Text="16"
                   FontWeight="Bold"
                   Foreground="#F97316" />
      </Grid>
      <Slider x:Name="LengthSlider"
              Minimum="4"
              Maximum="100"
              Value="16"
              TickFrequency="1"
              IsSnapToTickEnabled="True"
              ValueChanged="OnLengthChanged" />
      <TextBlock Text="Include characters"
                 FontWeight="SemiBold"
                 Margin="0,4,0,0" />
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
        <CheckBox x:Name="UppercaseCheckBox"
                  Content="Uppercase (A–Z)"
                  IsChecked="True"
                  IsCheckedChanged="OnOptionsChanged" />
        <CheckBox x:Name="LowercaseCheckBox"
                  Grid.Column="1"
                  Content="Lowercase (a–z)"
                  IsChecked="True"
                  IsCheckedChanged="OnOptionsChanged" />
        <CheckBox x:Name="NumbersCheckBox"
                  Grid.Row="1"
                  Content="Numbers (0–9)"
                  IsChecked="True"
                  IsCheckedChanged="OnOptionsChanged" />
        <CheckBox x:Name="SymbolsCheckBox"
                  Grid.Row="1"
                  Grid.Column="1"
                  Content="Symbols (!@#…)"
                  IsChecked="False"
                  IsCheckedChanged="OnOptionsChanged" />
      </Grid>
      <CheckBox x:Name="ExcludeAmbiguousCheckBox"
                Content="Avoid ambiguous characters (0, O, l, 1)"
                IsChecked="False"
                IsCheckedChanged="OnOptionsChanged" />
      <TextBlock x:Name="StatusText"
                 Classes="muted"
                 MinHeight="36"
                 HorizontalAlignment="Center" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <Button Content="Generate new password"
              Click="OnGenerateClicked"
              HorizontalContentAlignment="Center"
              Padding="12,10" />
      <Button Grid.Column="1"
              Content="Copy"
              Click="OnCopyClicked"
              Padding="18,10" />
    </Grid>
  </Grid>
</Window>
